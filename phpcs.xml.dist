<?xml version="1.0"?>
<ruleset name="read-aloud">
    <description>PSR-12 for read-aloud.</description>
    <file>src</file>
    <file>tests</file>
    <file>examples</file>
    <file>read-aloud.php</file>
    <file>uninstall.php</file>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <rule ref="PSR12">
        <exclude name="Generic.Files.LineLength"/>
    </rule>
    <!-- WP-CLI maps subcommands with hyphens to method names with underscores. -->
    <rule ref="PSR1.Methods.CamelCapsMethodName.NotCamelCaps">
        <exclude-pattern>src/Cli/Command.php</exclude-pattern>
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <!-- Plugin entry files and stubs declare and run code by design. -->
    <rule ref="PSR1.Files.SideEffects.FoundWithSymbols">
        <exclude-pattern>read-aloud.php</exclude-pattern>
        <exclude-pattern>examples/*</exclude-pattern>
        <exclude-pattern>tests/stubs/*</exclude-pattern>
        <exclude-pattern>tests/bootstrap.php</exclude-pattern>
        <exclude-pattern>tests/phpstan-bootstrap.php</exclude-pattern>
    </rule>
    <rule ref="PSR1.Classes.ClassDeclaration.MissingNamespace">
        <exclude-pattern>tests/stubs/*</exclude-pattern>
        <exclude-pattern>examples/*</exclude-pattern>
    </rule>
    <rule ref="PSR1.Classes.ClassDeclaration.MultipleClasses">
        <exclude-pattern>tests/stubs/*</exclude-pattern>
    </rule>
    <rule ref="Squiz.Classes.ValidClassName.NotCamelCaps">
        <exclude-pattern>tests/stubs/*</exclude-pattern>
    </rule>
</ruleset>
