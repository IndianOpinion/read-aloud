{
    "name": "indianopinion/read-aloud",
    "description": "WordPress plugin: turn a post into an audio file once, through any text-to-speech API, with editor approval, a daily cap and a kill switch.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "keywords": ["wordpress", "text-to-speech", "audio", "accessibility", "tts"],
    "homepage": "https://github.com/IndianOpinion/read-aloud",
    "support": {
        "issues": "https://github.com/IndianOpinion/read-aloud/issues",
        "email": "hello@indianopinion.org"
    },
    "require": {
        "php": ">=8.1"
    },
    "suggest": {
        "ext-intl": "Unicode NFC normalisation of the spoken text. Without it the normaliser runs in a documented reduced mode."
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.1",
        "php-stubs/wordpress-stubs": "^6.4",
        "php-stubs/wp-cli-stubs": "^2.10",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "IndianOpinion\\ReadAloud\\": "src/"
        },
        "files": ["src/functions.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "IndianOpinion\\ReadAloud\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "phpcs",
        "check": ["@lint", "@analyse", "@test"]
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        }
    }
}
